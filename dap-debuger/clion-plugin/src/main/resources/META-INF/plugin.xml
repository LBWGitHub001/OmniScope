<idea-plugin>
    <id>com.rm2027.swd-watch</id>
    <name>SWD Watch</name>
    <vendor>RM2027</vendor>
    <description>Watch globals and statics over the OpenOCD session CLion already started.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.clion</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="SWD Watch"
                    anchor="right"
                    icon="AllIcons.Debugger.Watch"
                    factoryClass="com.rm2027.swdwatch.SwdWatchToolWindowFactory"/>
        <postStartupActivity implementation="com.rm2027.swdwatch.SwdStartupActivity"/>
    </extensions>
</idea-plugin>
