@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# 只有 C++ 版本 (OmniScope::Cpp) 才需要这些依赖。
# 仅链接 OmniScope::Embedded 的工程不会被强制查找 OpenCV / fmt / Eigen3 等。
find_dependency(Threads)
find_dependency(OpenCV COMPONENTS core imgcodecs imgproc calib3d highgui)
find_dependency(fmt)
find_dependency(nlohmann_json)
find_dependency(yaml-cpp)
find_dependency(Eigen3)

include("${CMAKE_CURRENT_LIST_DIR}/OmniScopeTargets.cmake")

check_required_components(OmniScope)
