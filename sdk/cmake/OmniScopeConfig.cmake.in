@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

if(@OpenCV_FOUND@)
  find_dependency(OpenCV COMPONENTS core imgcodecs imgproc)
endif()

if(@nlohmann_json_FOUND@)
  find_dependency(nlohmann_json)
endif()

if(@fmt_FOUND@)
  find_dependency(fmt)
endif()

if(@yaml-cpp_FOUND@)
  find_dependency(yaml-cpp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OmniScopeTargets.cmake")

check_required_components(OmniScope)
